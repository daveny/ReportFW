@using System
@using Core.Controllers
@using Core.Helpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>

    <!-- CSS references -->
    @Styles.Render("~/Content/css")
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/Content/all.min.css" rel="stylesheet" />
    <link href="~/Content/css/filters.css" rel="stylesheet" />


    @RenderSection("styles", required: false)

    <script src="~/Scripts/chart.min.js"></script>

</head>
<body>
@{
    var isAuthenticated = Request.IsAuthenticated;
    var isManagedAdmin = isAuthenticated && ManagedSegmentHelper.IsAdmin(User);
    var activeViewAsAccount = isAuthenticated ? ManagedSegmentHelper.GetViewAsAccount() : null;
    var viewAsGroups = isAuthenticated ? ManagedSegmentHelper.GetViewAsGroups() : Array.Empty<string>();
    var signedInAccount = User?.Identity?.Name ?? string.Empty;
    var viewAsMessage = TempData["ManagedSegmentViewAsMessage"] as string;
    var viewAsError = TempData["ManagedSegmentViewAsError"] as string;
    var currentUrl = Context?.Request?.RawUrl ?? Url.Action("Index", "Home");
}
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Reports", "List", "Report", new { area = "" }, new { @class = "nav-link" })</li>

                    <!-- Metrics dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMetrics" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Metrics
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownMetrics">
                            <li>@Html.ActionLink("Metric Library", "Library", "Metric", new { area = "" }, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("My Metrics", "MyMetrics", "Metric", new { area = "" }, new { @class = "dropdown-item" })</li>
                            <li><hr class="dropdown-divider"></li>
                            <li>@Html.ActionLink("New Metric (.thtml editor)", "Index", "Editor", new { area = "" }, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>

                    <li>@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>

                @if (isAuthenticated)
                {
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item d-flex align-items-center">
                            <span class="navbar-text text-white me-2">
                                <i class="fas fa-user me-2"></i> @(string.IsNullOrWhiteSpace(signedInAccount) ? "(unknown)" : signedInAccount)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(activeViewAsAccount))
                            {
                                <span class="badge bg-info text-dark">View as: @activeViewAsAccount</span>
                            }
                        </li>
                        @if (isManagedAdmin)
                        {
                            <li class="nav-item ms-3">
                                @using (Html.BeginForm("SetViewAs", "ManagedSegment", FormMethod.Post, new { @class = "d-flex align-items-center" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-secondary text-white">View as</span>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-light" name="viewAs" value="@(activeViewAsAccount ?? string.Empty)" placeholder="DOMAIN\\user" />
                                        <button type="submit" class="btn btn-outline-light">Apply</button>
                                        @if (!string.IsNullOrWhiteSpace(activeViewAsAccount) || (viewAsGroups?.Count ?? 0) > 0)
                                        {
                                            <button type="submit" name="clear" value="1" class="btn btn-outline-warning">Clear</button>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @if (!string.IsNullOrWhiteSpace(viewAsMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <strong>View as:</strong> @viewAsMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(viewAsError))
        {
            <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                <strong>View as:</strong> @viewAsError
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>
    
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/datatables.min.js"></script>
    <script src="~/Scripts/bootstrap-datepicker.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
